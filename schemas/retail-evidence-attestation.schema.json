{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-captures/schemas/retail-evidence-attestation.schema.json",
  "title": "Retail PCAP evidence verification attestation, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicRepositoryCommit", "approvedInputSha256", "toolVersions", "check", "result"],
  "properties": {
    "schemaVersion": {"const": 1},
    "publicRepositoryCommit": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "approvedInputSha256": {"const": "20a78b9f40ff2393037c9a160c957783cf590b4f01797493d22fcd2039e9cbff"},
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "verifier"],
      "properties": {
        "python": {"const": "3.12"},
        "verifier": {"const": "1.0"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "pcap-1.23b-products-v1"},
        "version": {"const": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"enum": ["pass", "fail"]}}
    }
  }
}
