{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xivlegacy.local/xivl-captures/schemas/pipeline.schema.json",
  "title": "Pipeline manifest",
  "description": "Validates pipelines/*.yaml. Each pipeline declares one runner and per-output generator provenance; cross-resolution is done by the validator.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "runner": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["tool", "version"],
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset": { "type": "string", "minLength": 1 },
          "generator": {
            "type": "object",
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "required": ["tool", "version"],
            "additionalProperties": false
          },
          "inputs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": { "source": { "type": "string", "minLength": 1 } },
                  "required": ["source"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "dataset": { "type": "string", "minLength": 1 } },
                  "required": ["dataset"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["dataset", "generator", "inputs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "runner", "outputs"],
  "additionalProperties": false
}
