{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xivlegacy.local/xivl-captures/schemas/navmut-observation.schema.json",
  "title": "Navmut world population observation",
  "description": "One immutable schema-v2 Navmut observation record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "map_bounds": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "notes": { "type": "string" },
    "observation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile-[0-9a-f]{16}$"
    },
    "rotation": { "type": "number" },
    "schema_version": { "const": 2 },
    "subject_name": { "type": "string" },
    "subject_type": {
      "enum": ["monster", "mmonster", "npc", "misc", "Misc"]
    },
    "zone": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "created_at",
    "map_bounds",
    "notes",
    "observation_id",
    "position",
    "profile_id",
    "rotation",
    "schema_version",
    "subject_name",
    "subject_type",
    "zone"
  ]
}
