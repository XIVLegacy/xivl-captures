{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xivlegacy.local/xivl-captures/schemas/status-wire-census.schema.json",
  "title": "Sanitized status-wire census accounting",
  "type": "object",
  "required": ["study_id", "coverage", "exclusions", "distributions", "per_capture_chronology", "boundaries"],
  "properties": {
    "study_id": {"const": "status-wire-projection-census"},
    "coverage": {
      "type": "object",
      "required": ["captures", "decoded_target_events", "unique_wire_status_ids", "unique_status_row_ids"],
      "properties": {
        "captures": {"const": 54},
        "decoded_target_events": {"const": 831},
        "unique_wire_status_ids": {"const": 3},
        "unique_status_row_ids": {"const": 3}
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls_signature_connections", "lobby_54994_connections", "other_non_game_connections", "unexpected_subevent_size", "unexpected_application_shape"],
      "properties": {
        "tls_signature_connections": {"const": 2},
        "lobby_54994_connections": {"const": 2},
        "other_non_game_connections": {"const": 0},
        "unexpected_subevent_size": {"const": 0},
        "unexpected_application_shape": {"const": 0}
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events_by_capture", "events_by_lane", "nonzero_statuses_per_event", "status_slots", "wire_status_ids", "status_row_ids", "status_names", "nibbles"],
      "properties": {
        "events_by_capture": {"$ref": "#/$defs/captureCountMap"},
        "events_by_lane": {"type": "object", "additionalProperties": false, "required": ["main"], "properties": {"main": {"const": 831}}},
        "nonzero_statuses_per_event": {"type": "object", "additionalProperties": false, "required": ["0", "1", "2"], "properties": {"0": {"const": 827}, "1": {"const": 3}, "2": {"const": 1}}},
        "status_slots": {"type": "object", "additionalProperties": false, "required": ["1", "2"], "properties": {"1": {"const": 4}, "2": {"const": 1}}},
        "wire_status_ids": {"type": "object", "additionalProperties": false, "required": ["0x5a59", "0x5adf", "0x5dbf"], "properties": {"0x5a59": {"const": 1}, "0x5adf": {"const": 2}, "0x5dbf": {"const": 2}}},
        "status_row_ids": {"type": "object", "additionalProperties": false, "required": ["223129", "223263", "223999"], "properties": {"223129": {"const": 1}, "223263": {"const": 2}, "223999": {"const": 2}}},
        "status_names": {"type": "object", "additionalProperties": false, "required": ["Protect", "Resting", "Well Fed"], "properties": {"Protect": {"const": 1}, "Resting": {"const": 2}, "Well Fed": {"const": 2}}},
        "nibbles": {
          "type": "object", "additionalProperties": false,
          "required": ["chant_kind_1", "chant_kind_2", "object_bits_8_11", "object_bits_14_15", "object_bits_12_13"],
          "properties": {
            "chant_kind_1": {"$ref": "#/$defs/nibbleCountMap"},
            "chant_kind_2": {"$ref": "#/$defs/nibbleCountMap"},
            "object_bits_8_11": {"$ref": "#/$defs/nibbleCountMap"},
            "object_bits_14_15": {"$ref": "#/$defs/nibbleCountMap"},
            "object_bits_12_13": {"$ref": "#/$defs/nibbleCountMap"}
          }
        }
      }
    },
    "per_capture_chronology": {
      "type": "object", "minProperties": 54, "maxProperties": 54,
      "propertyNames": {"pattern": "^[a-z0-9_]+\\.pcapng$"},
      "additionalProperties": {"$ref": "#/$defs/captureChronology"}
    },
    "boundaries": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "captureCountMap": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9_]+\\.pcapng$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "nibbleCountMap": {
      "type": "object",
      "propertyNames": {"pattern": "^(?:[0-9]|1[0-5])$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "statusEntry": {
      "type": "object", "additionalProperties": false, "required": ["slot", "wire_status_id_hex"],
      "properties": {"slot": {"type": "integer", "minimum": 1, "maximum": 20}, "wire_status_id_hex": {"enum": ["0x5a59", "0x5adf", "0x5dbf"]}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "lane_index", "lane", "source_actor", "target_actor", "statuses"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1}, "lane_index": {"type": "integer", "minimum": 0},
        "lane": {"const": "main"}, "source_actor": {"type": "string", "pattern": "^actor-[0-9]{2,3}$"},
        "target_actor": {"type": "string", "pattern": "^actor-[0-9]{2,3}$"},
        "statuses": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/statusEntry"}}
      }
    },
    "captureChronology": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "event_count", "actor_pseudonym_count", "exclusions"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "event_count": {"type": "integer", "minimum": 0},
        "actor_pseudonym_count": {"type": "integer", "minimum": 0},
        "exclusions": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "tls_signature_connections": {"type": "integer", "minimum": 0},
            "lobby_54994_connections": {"type": "integer", "minimum": 0},
            "other_non_game_connections": {"type": "integer", "minimum": 0},
            "unexpected_subevent_size": {"type": "integer", "minimum": 0},
            "unexpected_application_shape": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
